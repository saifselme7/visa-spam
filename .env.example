# ---------------------------------------------------------------------------
# VOIDCARD environment configuration
#
# Everything with a VITE_ prefix is embedded in the JavaScript bundle and is
# therefore PUBLIC. Treat every value below as world-readable.
#
# NEVER put these in this file (or any VITE_ variable):
#   - Supabase service-role key      -> bypasses Row Level Security
#   - Payment provider API secrets   -> can move money
#   - Wallet private keys / seed phrases
#   - SMTP or server credentials
# Those belong in server-side environments: Supabase Edge Function secrets,
# your hosting provider's secret store, or the provider dashboard.
# ---------------------------------------------------------------------------

# PUBLIC — branding and links
VITE_APP_NAME=VOIDCARD
VITE_APP_URL=https://voidcard.example
VITE_SUPPORT_EMAIL=support@voidcard.example

# PUBLIC — Supabase project URL. Safe to ship.
VITE_SUPABASE_URL=

# PUBLIC — Supabase anon key. Protected by Row Level Security, not by secrecy.
# This is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# Demo mode: run the app on local mocks with a simulated account and simulated
# payment states. MUST be false in any real deployment — a production build with
# this enabled logs a loud error (see src/config/env.ts).
VITE_DEMO_MODE=true
